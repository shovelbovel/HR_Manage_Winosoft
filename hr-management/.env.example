ENVIRONMENT=dev
APP_NAME=HR Management

JWT_SECRET_KEY=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Dev-only key, generate a fresh one for any non-throwaway environment:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=cD4dKKfPYijzbaMghjNwGL9lEgzBK_5MXphNQMKBQu8=

BCRYPT_ROUNDS=12
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

GOOGLE_CLOUD_PROJECT=hr-management-dev
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199

COOKIE_NAME=hr_access_token
REFRESH_COOKIE_NAME=hr_refresh_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

SEED_ADMIN_EMAIL=admin@hr-management.dev
SEED_ADMIN_PASSWORD=ChangeMe123!

# Module 12 (Assistant intelligent) — optional. Leave blank to keep the
# module unusable (it's also off by default via /settings/ai regardless).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
