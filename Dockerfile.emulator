# syntax=docker/dockerfile:1
#
# Custom, pinned Firebase emulator image (Firestore + Auth + Storage need a
# JRE; the emulator suite itself needs Node). Built in-repo instead of
# depending on an unofficial prebuilt image, for reproducibility.

FROM node:20-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends openjdk-17-jre-headless \
    && rm -rf /var/lib/apt/lists/*

RUN npm install -g firebase-tools@13.29.1

WORKDIR /srv

COPY docker/emulator-entrypoint.sh /usr/local/bin/emulator-entrypoint.sh
RUN chmod +x /usr/local/bin/emulator-entrypoint.sh

EXPOSE 4000 8080 9099 9199

ENTRYPOINT ["/usr/local/bin/emulator-entrypoint.sh"]
