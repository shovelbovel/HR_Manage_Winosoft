rules_version = '2';

// Deny-all by default. The application talks to Firestore exclusively via the
// Admin SDK (firebase-admin) from the FastAPI server, which is not subject to
// these Security Rules. They are still deployed and versioned as defense in
// depth for two situations: an eventual direct client SDK access, and the
// accidental leak of a client-side API key. See cahier des charges v3.0,
// "Règles de sécurité de la base".
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
